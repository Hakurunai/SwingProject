!ifndef SWING__PUML
!define SWING__PUML

!include async/SwingAsyncPackage.puml
!include ../../controller/ControllerPackage.puml

package view.swing
{
    interface ISwingInterface
    {
        + Display()
        + Hide()
    }

    abstract class SwingView
    {
        # config : SwingViewConfig
        # controller : GUIController

        + SwingView(config, controller)
        + Close()

        # {abstract} Init()
        # InternalClose()
    }

    note left of SwingView::Init
        Called from the ctor
        Will serve to create the
        interface with Swing components
    end note

    class SwingViewConfig
    {
        - title : String
        - width : int
        - height : int

        + SwingViewConfig(title, width, height)
        + {static} DEFAULT : SiteConfig
        - {static} static()
    }

    abstract class SwingDialog
    {
        # dialog : JDialog

        + SwingDialog(config, controller, frameOwner : JFrame, isModal : boolean)
        + Display() <<implementation>>
        + Hide() <<implementation>>
        # InternalClose() <<implementation>>
    }

    abstract class SwingFrame
    {
        # frame : JFrame

        + SwingFrame(config, controller)
        + Display() <<implementation>>
        + Hide() <<implementation>>
        # InternalClose() <<implementation>>
    }


    SwingView ..|> ISwingInterface
    SwingFrame --|> SwingView
    SwingDialog --|> SwingView

    SwingView "0-n" *-- "1" SwingViewConfig
}

controller.GUIController "1" --o view.swing.SwingView


!endif