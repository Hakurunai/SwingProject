!ifndef SWING__PUML
!define SWING__PUML

!include async/SwingAsyncPackage.puml


package view.swing
{
    interface ISwingInterface
    {
        + Display()
        + Hide()
    }

    abstract class SwingView
    {
        + SwingView(config : SwingViewConfig, autoShow : boolean)
        # {abstract} Init()
        # Autoshow(autoshow : boolean)
    }

    note left of SwingView::Init
        Called from the ctor
        Will serve to create the
        interface with Swing components
    end note

    class SwingViewConfig
    {
        - title : String
        - width : int
        - height : int

        + SwingViewConfig(title, width, height)
        + {static} DEFAULT : SiteConfig
    }

    abstract class SwingDialog
    {
        # dialog : JDialog

        # SwingDialog(config : SwingViewConfig, frameOwner : JFrame, isModal : boolean, autoShow : boolean)
        + Display()
        + Hide()
    }

    abstract class SwingFrame
    {
        # frame : JFrame

        #Frame(config : SwingInterfaceConfig, autoShow : boolean)
        + Display()
        + Hide()
    }

    abstract SwingHelper
    {
        + {static} SetSameSize(JComponent[])
        + {static} DetermineMaxSize(JComponent[]) : Dimension
        + {static} AddComponentToPanelWithStruts(JPanel, JComponent[], final int, final int)
        + {static} CreateNonEditableTextArea() : JTextArea
    }

    SwingView ..|> ISwingInterface
    SwingFrame --|> SwingView
    SwingDialog --|> SwingView

    SwingView "0-n" *-- "1" SwingViewConfig
}


!endif