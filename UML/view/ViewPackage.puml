!ifndef VIEW__PUML
!define VIEW__PUML

!include swing/SwingPackage.puml
!include ../controller/ControllerPackage.puml

package view
{
    class FrontApp
    {
        - allOrder : Hashmap<String, Order>
        - allProduct : Hashmap<String, Product>

        - homeViewConfig : SwingViewConfig

        + FrontApp()
        - LaunchApp()
        + EstablishConnection(backApp : BackApp)

        - LoadConfig()
        - LoadCustomConfig() : boolean
        - LoadDefaultConfig()

        - CreateHomeView()
        - ConnectToDatabase(remoteController : AppController) : OperationResult<Void>
        - GetDataFromDatabase()

        # ListAllProducts() : String
        # ListAllOrder() : String
        # ListOrder(final int id) : String
    }


    class HomeFrame <<final>>
    {
        - JTextArea infoArea
        - JTextArea productDetailArea

        - buttonShowStorage : JButton
        - buttonShowOrder : JButton
        - buttonShowSpecificOrder : JButton
        - buttonMakeDeliveries : JButton
        - buttonComputeProfit : JButton
