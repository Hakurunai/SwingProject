        - buttonGenerateBackUp : JButton

        - {static} PANEL_BORDER_SIZE : int {final}

        # Init()

        - JPanel CreateCenterPanel()
        - JPanel CreateInfoArea()
        - JPanel CreateListAndDescriptionPanel()
        - JPanel CreateButtonPanel()
