!ifndef MODEL__PUML
!define MODEL__PUML


!include dao/DAOPackage.puml


!include ../util/UtilPackage.puml
!include ../controller/ControllerPackage.puml


package model
{
    class ID <<record>>
    {
        - id : string
    }

    class Category <<record>>
    {
        - categoryName : string
    }

    class BackApp
    {
        + BackApp(database)

        + IsAbleToReceiveNewConnection() : boolean
        + RequestConnection(GUIController) : AppController
    }

    class Product
    {
        - name : String
        - price : float
        - storedQuantity : int

        + Product(id : ID, name, category : Category, price)
        + Product(other : Product)
        - Product(name, category : Category, price)
        + {static} GenerateProductDTO(name, category : Category, price) : Product
    }

    class Order
    {
        - creationDate : LocalDate
        - clientName : String
        - orderedProduct : ArrayList<Product>
        - isDelivered : boolean
        - nonDeliveredExplanation : String

        + Order(id : ID, creationDate, clientName, orderedProduct)
        + Order(other : Order)
        - Order(creationDate, clientName, orderedProduct)

        + UpdateToNonDeliveredStatus(explanation : String)
        + UpdateToDeliveredStatus()
        + {static} GenerateOrderDTO(creationDate, clientName, orderedProduct) : Order
    }

    class Database
    {
        - productMap : Hashmap<Category, Hashmap<ID, Product>>
        - orderMap : Hashmap<ID, Order>

        - dataPath : String

        + Database(dataPath : String)

        + SaveProductToFile(productPath : String) : OperationResult<Void>
        + SaveOrderToFile(orderPath : String) : OperationResult<Void>

        + CreateNewProduct(data : Product) : OperationResult<ID>
        + CreateNewProductCategory(category : Category) OperationResult<Void>
        + ReadProduct(id : ID) : OperationResult<Product>
        + ReadAllProduct() : OperationResult<Product[]>
        + UpdateProduct(data : Product) OperationResult<Void>
        + DeleteProduct(id : ID) OperationResult<Void>

        + CreateNewOrder(data : Order) : OperationResult<ID>
        + ReadOrder(id : ID) : OperationResult<Order>
        + ReadAllOrder() : OperationResult<Order[]>
        + UpdateOrder(data : Order) OperationResult<Void>
        + DeleteOrder(id : ID) OperationResult<Void>

        - Init()
        - CheckIfProductCategoryExist(cat : Category) : OperationResult<Void>
        - SplitProductID(productId : ID) : OperationResult<String[]>
    }

    note right of Database::productMap
        First map use category as key
        Next map use complete id
    end note

    class OperationResult <T>
    {
        - data : T
        - message : final String
        - success : final boolean

        - OperationResult(data, message, success)

        + Success(message : String, data : T) : OperationResult<T>
        + Success(message : String) : OperationResult<T>
        + Failure(message : String) : OperationResult<T>

        + HasSucceeded() : boolean
        + GetMessage() : String
        + GetData() : T
    }

    class DataIdGenerator
    {
        - currentId : long

        + DataIdGenerator()
        + TryUpdateCurrentId(value : long)
        + GetNextId() : long
        + GetNextIdAsString() : String
    }

    Order "0,n" o-- "1-n" Product

    Order "0-n" --* Database
    Product "0-n" --* Database

    ID "1" --* Order
    ID "1" --* Product

    Category "1" --* Product


    DataIdGenerator "2" --* Database

    Database "1" --o BackApp
}

model.Database --> util.SerializerHelper
controller.AppController "1" --* model.BackApp

!endif